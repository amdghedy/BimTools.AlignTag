<Window x:Class="AlignTool.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BimTools.Align" Height="280" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid Margin="16">
    <StackPanel>
      <TextBlock Text="BimTools.Align" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Tag Align Suite for Autodesk Revit 2020" Margin="0,4,0,12"/>
      <TextBlock Text="Version 2.3.0"/>
      <TextBlock Text="BIM TOOLS" Margin="0,12,0,0"/>
      <Button Content="OK" Width="80" HorizontalAlignment="Right" Margin="0,24,0,0" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
