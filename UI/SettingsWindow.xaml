<Window x:Class="AlignTool.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlignTool Settings" Height="360" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Stack spacing (mm)"/>
      <TextBox x:Name="TxtSpacing" Margin="0,4,0,12"/>
      <TextBlock Text="Max move (mm)"/>
      <TextBox x:Name="TxtMaxMove" Margin="0,4,0,12"/>
      <TextBlock Text="Minimize leader (mm)"/>
      <TextBox x:Name="TxtMinimize" Margin="0,4,0,12"/>
      <CheckBox x:Name="ChkSkipPinned" Content="Skip pinned tags" Margin="0,0,0,8"/>
      <CheckBox x:Name="ChkLogging" Content="Enable file logging"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" Width="80" Margin="0,0,8,0" Click="Save_Click"/>
      <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
